{
  "type": "object",
  "properties": {
    "campaign_id": { "type": "string" },
    "topic": { "type": "string" },
    "generated_at": { "type": "string" },
    "youtube_payload": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description_body": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "thumbnail_top_text": { "type": "string" }
          },
          "required": ["title", "description_body", "tags", "thumbnail_top_text"]
        },
        "segments": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "segment_index": { "type": "integer" },
              "chapter_title": { "type": "string" },
              "visual_mode": { "type": "string", "enum": ["STUDIO_AVATAR_DIRECT", "CHART_B_ROLL_WITH_PIP"] },
              "avatar_studio_id": { "type": "integer" },
              "b_roll_asset_ref": { "type": "string" },
              "spoken_narration": { "type": "string" }
            },
            "required": ["segment_index", "chapter_title", "visual_mode", "avatar_studio_id", "spoken_narration"]
          }
        },
        "short_extraction": {
          "type": "object",
          "properties": {
            "short_title": { "type": "string" },
            "spoken_hook_and_body": { "type": "string" },
            "cta_to_long_video": { "type": "string" },
            "chart_image_ref": { "type": "string" }
          },
          "required": ["short_title", "spoken_hook_and_body", "cta_to_long_video", "chart_image_ref"]
        },
        "short_extractions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Exactly 2 DISTINCT 45-second Short angles cut from this research session. Short #1 = 'The Core Trap/Hook' (emotional punch, contrarian claim). Short #2 = 'The Quantitative Proof/Rule' (a number-driven mechanics breakdown). Both must map to DIFFERENT chart_image_refs when possible.",
          "items": {
            "type": "object",
            "properties": {
              "short_title": { "type": "string" },
              "spoken_hook_and_body": { "type": "string" },
              "cta_to_long_video": { "type": "string" },
              "chart_image_ref": { "type": "string" },
              "angle": { "type": "string", "enum": ["core_trap_hook", "quantitative_proof_rule"] }
            },
            "required": ["short_title", "spoken_hook_and_body", "cta_to_long_video", "chart_image_ref"]
          }
        }
      },
      "required": ["metadata", "segments", "short_extraction"]
    },
    "website_article_payload": {
      "type": "object",
      "properties": {
        "seo_title": { "type": "string" },
        "meta_description": { "type": "string" },
        "tldr_summary": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "seo_meta": {
          "type": "object",
          "properties": {
            "h1_title": { "type": "string" }
          },
          "required": ["h1_title"]
        },
        "article_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "h2_title": { "type": "string" },
              "direct_answer_passage": { "type": "string" },
              "chart_image_ref": { "type": "string" },
              "body_paragraphs": { "type": "string" }
            },
            "required": ["h2_title", "direct_answer_passage", "chart_image_ref", "body_paragraphs"]
          }
        }
      },
      "required": ["seo_title", "meta_description", "seo_meta", "tldr_summary", "article_sections"]
    }
  },
  "required": ["campaign_id", "topic", "youtube_payload", "website_article_payload"]
}
