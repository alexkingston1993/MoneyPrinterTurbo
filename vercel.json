{
  "version": 2,
  "name": "the-bull-print",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/mission-control",
      "destination": "/mission-control.html"
    },
    {
      "source": "/admin",
      "destination": "/mission-control.html"
    },
    {
      "source": "/api/mission-control/auth",
      "destination": "/api/mission-control/auth.js"
    },
    {
      "source": "/api/mission-control/telemetry",
      "destination": "/api/mission-control/telemetry.js"
    },
    {
      "source": "/api/mission-control/action",
      "destination": "/api/mission-control/action.js"
    },
    {
      "source": "/go/:broker",
      "destination": "/api/go?broker=:broker"
    },
    {
      "source": "/api/go/:broker",
      "destination": "/api/go?broker=:broker"
    },
    {
      "source": "/go",
      "destination": "/tools.html"
    },
    {
      "source": "/stocks/:symbol",
      "destination": "/stock.html"
    },
    {
      "source": "/stocks",
      "destination": "/stock.html"
    },
    {
      "source": "/screens/:slug",
      "destination": "/screener.html"
    },
    {
      "source": "/screens",
      "destination": "/screener.html"
    },
    {
      "source": "/screener",
      "destination": "/screener.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/calculators",
      "destination": "/calculators.html"
    },
    {
      "source": "/article/:slug",
      "destination": "/article.html"
    },
    {
      "source": "/article",
      "destination": "/article.html"
    },
    {
      "source": "/events/:slug",
      "destination": "/events.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/ipo/:slug",
      "destination": "/ipo.html"
    },
    {
      "source": "/ipo",
      "destination": "/ipo.html"
    },
    {
      "source": "/unlisted/:slug",
      "destination": "/unlisted.html"
    },
    {
      "source": "/unlisted",
      "destination": "/unlisted.html"
    },
    {
      "source": "/fno",
      "destination": "/fno.html"
    },
    {
      "source": "/insurance",
      "destination": "/insurance.html"
    },
    {
      "source": "/crypto",
      "destination": "/crypto.html"
    },
    {
      "source": "/articles",
      "destination": "/articles.html"
    },
    {
      "source": "/schemes",
      "destination": "/schemes.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=30, s-maxage=30" }
      ]
    }
  ]
}
